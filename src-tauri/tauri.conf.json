{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyBoard",
  "version": "../package.json",
  "identifier": "com.copyboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:react",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist-react"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CopyBoard",
        "width": 820,
        "height": 620,
        "minWidth": 520,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "quick-access",
        "title": "CopyBoard Templates",
        "url": "index.html?surface=quick-access",
        "width": 278,
        "height": 64,
        "decorations": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright CopyBoard",
    "shortDescription": "Local clipboard history and favorites",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Russian"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
